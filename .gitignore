# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# Virtual environment
venv/
.venv/

# Face models (large files, fetched by download_models.py or baked into the image).
# The directory itself is kept, via .gitkeep, because the Docker build copies it.
face-verification-service/models/*.onnx
face-verification-service/models/*.caffemodel
face-verification-service/models/*.prototxt
!face-verification-service/models/.gitkeep

# The standalone enrolment gallery holds face embeddings - biometric data about
# identifiable people. It never belongs in version control.
face-verification-service/data/

# Java / Maven
**/target/
*.class
*.jar
*.war

# Node
**/node_modules/
.vite/

# IDE
.vscode/
.idea/
*.iml

# OS
Thumbs.db
.DS_Store
desktop.ini

# Environment variables
.env
.env.local

# Data / datasets
dataset/
*.crdownload

# MongoDB
data/db/

# Logs
*.log

# Temp files
*.tmp
*.bak

# Training outputs
checkpoints/
outputs/
wandb/
runs/
